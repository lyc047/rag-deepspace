{
  "version": "1.0",
  "experiment_id": "stage7_s7_4a1_checkpoint_protocol_scan_v1",
  "status": "registered_before_execution",
  "created_date": "2026-07-30",
  "evidence_role": "stage7_development_full_protocol_checkpoint_scan_not_candidate_validation",
  "objective": "Test whether a silence-triggered self-contained bank checkpoint can replace fixed request-response heartbeats and improve the full-protocol clean-bit frontier.",
  "inputs": {
    "development_split": "configs/stage7_development_split_v1.json",
    "electrosense_protocol": "configs/stage6r_electrosense_external_final_protocol_v1.json",
    "electrosense_registry": "results/stage6r/electrosense_final_registry_v1/registry.json",
    "electrosense_access_state": "configs/stage6r_electrosense_final_access_state_v1.json",
    "electrosense_freeze": "results/stage6r/electrosense_final_freeze_v1/result.json",
    "matched_scan_config": "configs/stage6r_matched_clean_scan_v1.json",
    "activation_protocol": "configs/stage6r_codebook_activation_protocol_v1.json",
    "s7_4a0_result": "results/stage7/s7_4a0_checkpoint_feasibility_v1/result.json"
  },
  "data": {
    "fit_split": "train",
    "diagnostic_split": "validation",
    "internal_development_test_signal_values_may_be_loaded": false,
    "reserve_values_may_be_loaded": false,
    "expected_train_site_count": 20,
    "expected_validation_site_count": 7
  },
  "task": {
    "n_channels": [8, 16, 32, 64],
    "demand_ratios": [0.25, 0.5, 0.75],
    "epsilon_db": 0.2,
    "primary_k": 4
  },
  "policies": {
    "fixed6_heartbeat": {
      "heartbeat_interval_scenes": 6,
      "checkpoint_interval_scenes": null
    },
    "fixed10_heartbeat": {
      "heartbeat_interval_scenes": 10,
      "checkpoint_interval_scenes": null
    },
    "fixed16_heartbeat": {
      "heartbeat_interval_scenes": 16,
      "checkpoint_interval_scenes": null
    },
    "checkpoint6": {
      "heartbeat_interval_scenes": null,
      "checkpoint_interval_scenes": 6
    },
    "checkpoint8": {
      "heartbeat_interval_scenes": null,
      "checkpoint_interval_scenes": 8
    },
    "checkpoint10": {
      "heartbeat_interval_scenes": null,
      "checkpoint_interval_scenes": 10
    },
    "checkpoint12": {
      "heartbeat_interval_scenes": null,
      "checkpoint_interval_scenes": 12
    },
    "checkpoint16": {
      "heartbeat_interval_scenes": null,
      "checkpoint_interval_scenes": 16
    }
  },
  "checkpoint_behavior": {
    "due_rule": "scenes_since_successful_feedback_reaches_interval",
    "replaces_request_response_heartbeat": true,
    "uses_current_spectrum_semantic_action": true,
    "uses_frozen_task_open_loop_attempt_count": true,
    "emits_normal_24_bit_cumulative_ack_when_accepted": true,
    "ack_loss_retains_sender_belief_uncertainty": true,
    "lost_or_rejected_checkpoint_never_creates_an_action": true,
    "unknown_bank_uses_existing_exact_or_full_install_fallback": true,
    "no_same_scene_duplicate_install_or_compact_update_after_checkpoint_attempt": true
  },
  "reliability": {
    "all_stage6r_workpoint_fields_frozen": true,
    "maximum_activation_attempts": 2,
    "catalog_epoch": 1,
    "codebook_epoch": 2,
    "paired_common_random_numbers": true
  },
  "monte_carlo": {
    "trajectories": 60,
    "random_seed": 20260730,
    "bootstrap_replicates": 5000,
    "bootstrap_seed": 20260919,
    "confidence_level": 0.95,
    "hierarchical_bootstrap_unit": "site_then_paired_trajectory"
  },
  "system_gate": {
    "reference_policy": "fixed10_heartbeat",
    "path_a": {
      "minimum_total_bit_reduction_percent": 5.0,
      "maximum_clean_loss_percentage_points": 0.5
    },
    "path_b": {
      "minimum_clean_gain_percentage_points": 1.0,
      "maximum_total_bit_increase_percent": 5.0
    },
    "minimum_passing_n_count": 3,
    "wrong_codebook_actions_must_equal": 0,
    "if_gate_passes": "freeze_best_common_checkpoint_interval_and_test_event_update_piggyback_ablation",
    "if_gate_fails": "reject_periodic_checkpoint_and_move_to_event_update_context_digest_piggyback"
  },
  "reporting": {
    "report_all_policies_and_all_n": true,
    "report_checkpoint_count_ack_rejection_escape_and_bits": true,
    "report_clean_availability_regret_cvar_longest_dirty_run": true,
    "report_forward_ack_heartbeat_recovery_and_total_bits": true,
    "no_interval_may_be_selected_from_only_one_n": true
  },
  "claim_boundary": [
    "This is a development protocol scan on previously consumed validation sites, not an external Final.",
    "The checkpoint is self-contained only for a matching preinstalled bank catalog.",
    "Unresolved sites remain on the identical exact fallback under every policy.",
    "Only the 7 validation sites may be loaded; internal development-test and reserve sites remain closed.",
    "All eight policies are reported even if one interval is favorable.",
    "A packet-size advantage alone is not a system-level clean-bit advantage."
  ]
}

  "status": "registered_after_failure_diagnostic_before_scripted_full_execution",
  "created_date": "2026-07-29",
  "purpose": "Prevent short-prefix context errors from installing or selecting a codebook until two adjacent calibration windows agree.",
  "evidence_role": "post_diagnostic_development_not_confirmatory",
  "inputs": {

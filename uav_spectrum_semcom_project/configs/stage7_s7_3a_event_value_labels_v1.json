{
  "version": "1.0",
  "experiment_id": "stage7_s7_3a_event_value_labels_v1",
  "status": "registered_before_execution",
  "created_date": "2026-07-30",
  "evidence_role": "stage7_development_label_and_counterfactual_upper_bound",
  "objective": "Determine whether persistent task failures and one-scene-ahead forced-refresh value form a less site-confounded and more protocol-relevant prediction target than any single regret-threshold crossing.",
  "inputs": {
    "governance": "configs/stage7_research_governance_v1.json",
    "development_split": "configs/stage7_development_split_v1.json",
    "electrosense_protocol": "configs/stage6r_electrosense_external_final_protocol_v1.json",
    "electrosense_registry": "results/stage6r/electrosense_final_registry_v1/registry.json",
    "electrosense_access_state": "configs/stage6r_electrosense_final_access_state_v1.json",
    "electrosense_freeze": "results/stage6r/electrosense_final_freeze_v1/result.json",
    "s7_1_result": "results/stage7/s7_1_strong_baselines_v1/result.json",
    "s7_2_result": "results/stage7/s7_2_lightweight_models_v1/result.json"
  },
  "data": {
    "fit_split": "train",
    "diagnostic_split": "validation",
    "internal_development_test_signal_values_may_be_loaded": false,
    "reserve_values_may_be_loaded": false,
    "expected_train_site_count": 20,
    "expected_validation_site_count": 7
  },
  "task": {
    "n_channels": [8, 16, 32, 64],
    "demand_ratios": [0.25, 0.5, 0.75],
    "epsilon_db": 0.2,
    "primary_k": 4,
    "evaluation_horizon_scenes": 10,
    "persistent_run_lengths": [2, 3],
    "primary_persistent_run_length": 2,
    "forced_refresh_offset_scenes": 1
  },
  "counterfactual": {
    "baseline": "keep_scene_t_decoder_action_for_10_future_scenes",
    "forced_refresh": "at_scene_t_plus_1_recompute_decoder_action_from_then_current_spectrum_and_hold_it_for_the_remaining_horizon",
    "forced_refresh_is_one_scene_ahead_scheduling_upper_bound": true,
    "packet_loss_ack_loss_context_reset_and_delayed_duplicate_not_simulated_in_s7_3a": true,
    "full_protocol_integration_required_in_s7_3b": true
  },
  "incremental_bit_cost": {
    "compact_frame_bits_by_n": {
      "8": 42,
      "16": 43,
      "32": 43,
      "64": 43
    },
    "task_update_open_loop_attempts_by_n": {
      "8": 1,
      "16": 2,
      "32": 2,
      "64": 1
    },
    "ack_bits": 24,
    "formula": "attempts_times_compact_frame_bits_plus_one_ack",
    "clean_scene_value_bits_grid": [32, 64, 128, 256]
  },
  "strong_baselines": [
    "action_duration_lookup",
    "symbol_markov_duration_lookup"
  ],
  "lookup": {
    "prior_strength": 10.0
  },
  "metrics": [
    "positive_prevalence",
    "positive_site_count",
    "dominant_site_event_share",
    "transient_fraction_among_any_failures",
    "persistent_fraction_among_any_failures",
    "forced_refresh_beneficial_fraction",
    "avoided_dirty_scenes",
    "avoided_excess_regret_db",
    "break_even_bits_per_avoided_dirty_scene",
    "aggregate_auc",
    "macro_within_site_auc"
  ],
  "label_viability_gate": {
    "minimum_passing_n_count": 3,
    "minimum_positive_validation_site_count": 3,
    "maximum_dominant_site_event_share": 0.8,
    "minimum_macro_within_site_auc": 0.6,
    "minimum_median_avoided_dirty_scenes_among_beneficial": 1.0
  },
  "decision_policy": {
    "if_gate_passes": "continue_to_s7_3b_full_protocol_protection_value_simulation",
    "if_events_exist_but_remain_site_concentrated": "retain_event_decomposition_but_require_more_temporally_diverse_sites_before_value_prediction",
    "if_forced_refresh_has_little_counterfactual_value": "stop_task_forecast_control_and_focus_on_analytic_context_belief_or_protocol_redesign"
  },
  "claim_boundary": [
    "Only the 20 train and 7 validation sites may be loaded.",
    "The 7 internal development-test and 3 reserve sites remain closed.",
    "S7.3a is a deterministic semantic-action counterfactual upper bound, not a packet-level reliability result.",
    "The forced-refresh action is recomputed at scene t+1 and is not future information available at scene t; scene t only schedules the refresh opportunity.",
    "Future spectra are used only to construct labels and counterfactual outcomes, never as inference features.",
    "No clean-bit system benefit may be claimed until S7.3b simulates packet loss, ACK loss, context resets, duplicates, recovery, and all protocol bits.",
    "No result from these already consumed sites may be called a Stage-7 external Final."
  ]
}

{
  "version": "1.0",
  "experiment_id": "stage7_s7_3b_full_protocol_oracle_v1",
  "status": "registered_before_execution",
  "created_date": "2026-07-30",
  "evidence_role": "stage7_post_label_full_protocol_oracle_diagnostic_not_candidate_validation",
  "objective": "Determine whether the S7.3a one-scene-ahead forced-refresh oracle can improve the full packet, ACK, reset, recovery and total-bit rate-risk frontier enough to justify acquiring more temporally diverse data for a causal value predictor.",
  "inputs": {
    "governance": "configs/stage7_research_governance_v1.json",
    "development_split": "configs/stage7_development_split_v1.json",
    "electrosense_protocol": "configs/stage6r_electrosense_external_final_protocol_v1.json",
    "electrosense_registry": "results/stage6r/electrosense_final_registry_v1/registry.json",
    "electrosense_access_state": "configs/stage6r_electrosense_final_access_state_v1.json",
    "electrosense_freeze": "results/stage6r/electrosense_final_freeze_v1/result.json",
    "matched_scan_config": "configs/stage6r_matched_clean_scan_v1.json",
    "activation_protocol": "configs/stage6r_codebook_activation_protocol_v1.json",
    "s7_3a_result": "results/stage7/s7_3a_event_value_labels_v1/result.json"
  },
  "data": {
    "fit_split": "train",
    "diagnostic_split": "validation",
    "internal_development_test_signal_values_may_be_loaded": false,
    "reserve_values_may_be_loaded": false,
    "expected_train_site_count": 20,
    "expected_validation_site_count": 7,
    "s7_3a_gate_failure_is_retained": true
  },
  "task": {
    "n_channels": [8, 16, 32, 64],
    "demand_ratios": [0.25, 0.5, 0.75],
    "epsilon_db": 0.2,
    "primary_k": 4,
    "oracle_label_horizon_scenes": 10,
    "oracle_refresh_offset_scenes": 1
  },
  "policies": {
    "fixed6": {
      "heartbeat_interval_scenes": 6,
      "forced_refresh_oracle": false
    },
    "fixed10": {
      "heartbeat_interval_scenes": 10,
      "forced_refresh_oracle": false
    },
    "fixed16": {
      "heartbeat_interval_scenes": 16,
      "forced_refresh_oracle": false
    },
    "fixed10_plus_forced_refresh_oracle": {
      "heartbeat_interval_scenes": 10,
      "forced_refresh_oracle": true
    },
    "fixed16_plus_forced_refresh_oracle": {
      "heartbeat_interval_scenes": 16,
      "forced_refresh_oracle": true
    }
  },
  "oracle_definition": {
    "decision_scene": "t",
    "forced_update_scene": "t_plus_1",
    "forced_update_payload": "normal_current-spectrum compact semantic update at t_plus_1",
    "trigger": "S7.3a forced_refresh_beneficial label computed with the actual future 10-scene spectrum",
    "mask_is_shifted_forward_one_scene": true,
    "mask_is_noncausal_and_not_deployable": true,
    "mask_does_not_observe_or_override_packet_ack_or_reset_randomness": true,
    "all_updates_use_frozen_codebook_escape_context_and_fail_closed_paths": true
  },
  "reliability": {
    "all_stage6r_workpoint_fields_frozen": true,
    "maximum_activation_attempts": 2,
    "catalog_epoch": 1,
    "codebook_epoch": 2,
    "paired_common_random_numbers": true
  },
  "monte_carlo": {
    "trajectories": 60,
    "random_seed": 20260730,
    "bootstrap_replicates": 5000,
    "bootstrap_seed": 20260903,
    "confidence_level": 0.95,
    "hierarchical_bootstrap_unit": "site_then_paired_trajectory"
  },
  "diagnostic_gate": {
    "reference_policy": "fixed10",
    "minimum_passing_n_count": 3,
    "path_a": {
      "minimum_total_bit_reduction_percent": 5.0,
      "maximum_clean_loss_percentage_points": 0.5
    },
    "path_b": {
      "minimum_clean_gain_percentage_points": 1.0,
      "maximum_total_bit_increase_percent": 5.0
    },
    "wrong_codebook_actions_must_equal": 0,
    "if_gate_passes": "seek_more_temporally_diverse_development_sites_before_training_a_causal_value_predictor",
    "if_gate_fails": "stop_task_forecast_protection_and_focus_on_analytic_context_belief_or_periodically_self_contained_protocols"
  },
  "reporting": {
    "report_all_five_policies": true,
    "report_all_four_n": true,
    "report_total_forward_ack_heartbeat_recovery_and_escape_bits": true,
    "report_clean_availability_mean_regret_cvar_and_longest_dirty_run": true,
    "report_oracle_trigger_prevalence_and_redundant_trigger_fraction": true,
    "no_model_training_or_threshold_selection": true
  },
  "claim_boundary": [
    "S7.3a failed its cross-site concentration gate; S7.3b is only a full-protocol value-of-information diagnostic.",
    "The oracle uses future spectra and is deliberately noncausal; it cannot be described as a deployable predictor.",
    "Only the 20 train and 7 validation sites may be loaded; the 7 internal development-test and 3 reserve sites remain closed.",
    "The four previously downloaded AERPAW archives were already consumed in Stage 6 and cannot provide independent S7.3 validation.",
    "The three ElectroSense structural-reserve sites lack an eligible FM member under the frozen rows and columns rule and are not silently substituted.",
    "A positive diagnostic only justifies acquiring broader development data; it does not override the failed S7.3a label gate.",
    "No result from these already consumed sites may be called a Stage-7 external Final."
  ]
}

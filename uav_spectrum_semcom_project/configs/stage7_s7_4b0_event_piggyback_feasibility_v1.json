{
  "version": "1.0",
  "experiment_id": "stage7_s7_4b0_event_piggyback_feasibility_v1",
  "status": "registered_before_execution",
  "created_date": "2026-07-30",
  "evidence_role": "stage7_development_event_piggyback_feasibility_not_candidate_validation",
  "objective": "Test whether upgrading only already-triggered semantic task updates into bank-resolving updates can support a sparser heartbeat without the periodic checkpoint cost.",
  "inputs": {
    "development_split": "configs/stage7_development_split_v1.json",
    "electrosense_protocol": "configs/stage6r_electrosense_external_final_protocol_v1.json",
    "electrosense_registry": "results/stage6r/electrosense_final_registry_v1/registry.json",
    "electrosense_access_state": "configs/stage6r_electrosense_final_access_state_v1.json",
    "electrosense_freeze": "results/stage6r/electrosense_final_freeze_v1/result.json",
    "matched_scan_config": "configs/stage6r_matched_clean_scan_v1.json",
    "activation_protocol": "configs/stage6r_codebook_activation_protocol_v1.json",
    "s7_4a_result": "results/stage7/s7_4a1_checkpoint_protocol_scan_v1/result.json"
  },
  "data": {
    "fit_split": "train",
    "diagnostic_split": "validation",
    "internal_development_test_signal_values_may_be_loaded": false,
    "reserve_values_may_be_loaded": false,
    "expected_train_site_count": 20,
    "expected_validation_site_count": 7
  },
  "task": {
    "n_channels": [8, 16, 32, 64],
    "demand_ratios": [0.25, 0.5, 0.75],
    "epsilon_db": 0.2,
    "primary_k": 4
  },
  "policies": {
    "fixed10_compact": {
      "heartbeat_interval_scenes": 10,
      "event_context_piggyback": false
    },
    "fixed16_compact": {
      "heartbeat_interval_scenes": 16,
      "event_context_piggyback": false
    },
    "piggyback12": {
      "heartbeat_interval_scenes": 12,
      "event_context_piggyback": true
    },
    "piggyback16": {
      "heartbeat_interval_scenes": 16,
      "event_context_piggyback": true
    },
    "piggyback24": {
      "heartbeat_interval_scenes": 24,
      "event_context_piggyback": true
    }
  },
  "event_upgrade_behavior": {
    "upgrade_only_existing_analytic_regret_or_age_updates": true,
    "never_create_an_update_only_for_context_identity": true,
    "replace_compact_frame_with_bank_resolving_frame": true,
    "reuse_existing_task_ack": true,
    "uses_current_measured_spectrum_action": true,
    "no_access_to_receiver_reset_event": true,
    "lost_or_rejected_frame_never_creates_an_action": true,
    "unknown_bank_uses_existing_exact_or_full_install_fallback": true
  },
  "reliability": {
    "all_stage6r_workpoint_fields_frozen": true,
    "maximum_activation_attempts": 2,
    "catalog_epoch": 1,
    "codebook_epoch": 2,
    "paired_common_random_numbers": true
  },
  "monte_carlo": {
    "trajectories": 60,
    "random_seed": 20260731,
    "bootstrap_replicates": 5000,
    "bootstrap_seed": 20260920,
    "confidence_level": 0.95,
    "hierarchical_bootstrap_unit": "site_then_paired_trajectory"
  },
  "feasibility_gate": {
    "reference_policy": "fixed10_compact",
    "path_a": {
      "minimum_total_bit_reduction_percent": 5.0,
      "maximum_clean_loss_percentage_points": 0.5
    },
    "path_b": {
      "minimum_clean_gain_percentage_points": 1.0,
      "maximum_total_bit_increase_percent": 5.0
    },
    "minimum_passing_n_count": 3,
    "wrong_codebook_actions_must_equal": 0,
    "if_gate_passes": "freeze_common_event_piggyback_policy_for_internal_development_test",
    "if_gate_fails": "stop_adding_stateful_context_components_and_audit_semi_stateless_headers"
  },
  "reporting": {
    "report_all_policies_and_all_n": true,
    "report_event_upgrade_count_incremental_bits_and_reset_rescues": true,
    "report_clean_availability_regret_cvar_longest_dirty_run": true,
    "report_forward_ack_heartbeat_recovery_and_total_bits": true,
    "no_policy_may_be_selected_from_only_one_n": true
  },
  "claim_boundary": [
    "This is a development feasibility test on previously consumed validation sites, not an external Final.",
    "The event frame is self-contained only for a matching preinstalled bank catalog.",
    "The policy is causal and cannot observe the receiver reset event.",
    "Unresolved sites remain on the identical exact fallback under every policy.",
    "Only the 7 validation sites may be loaded; internal development-test and reserve sites remain closed.",
    "A favorable single N cannot pass the common-policy gate."
  ]
}

{
  "version": "1.0",
  "experiment_id": "stage6r_activation_activity_session_validation_v1",
  "status": "registered_after_dry_run_before_execution",
  "created_date": "2026-07-29",
  "purpose": "Validate the implemented known-bank activation protocol across activities and cold-start session lengths using the frozen clean-0.90 workpoints.",
  "inputs": {
    "activation_protocol": "configs/stage6r_codebook_activation_protocol_v1.json",
    "activation_dry_run": "results/stage6r/activation_protocol_dry_run_v1/result.json",
    "adaptation_config": "configs/stage6r_few_shot_adaptation_v1.json",
    "temporal_gate_result": "results/stage6r/temporal_context_gate_v1/result.json",
    "matched_scan_config": "configs/stage6r_matched_clean_scan_v1.json",
    "matched_scan_result": "results/stage6r/matched_clean_scan_v1/result.json",
    "full_manifest_activity_diagnostic": "results/stage6r/activity_session_diagnostic_v1/result.json",
    "external_final_access_state": "configs/stage6_external_final_access_state.json"
  },
  "frozen_selection": {
    "matched_clean_target": 0.9,
    "primary_k": 4,
    "maximum_activation_attempts": 2,
    "catalog_epoch": 1,
    "codebook_epoch": 2,
    "workpoints_and_action_tuples_may_be_reselected": false
  },
  "catalog_bank_ids": {
    "aerpaw_packapalooza_2023": 1,
    "aerpaw_lake_wheeler_2024": 2,
    "aerpaw_packapalooza_2024": 3,
    "aerpaw_packapalooza_2025": 4
  },
  "session_length_scenes": [20, 50, 100, null],
  "segmentation": {
    "order": "chronological_non_overlapping",
    "remainder": "retain_only_if_more_than_calibration_scene_count",
    "each_segment_starts_with_empty_context": true,
    "known_bank_catalog_survives_context_reset": true,
    "ood_uses_full_manifest": true
  },
  "monte_carlo": {
    "trajectories": 60,
    "random_seed_must_equal_matched_scan": true,
    "bootstrap_replicates": 5000,
    "bootstrap_seed": 20260803,
    "confidence_level": 0.95,
    "paired_common_random_numbers": true
  },
  "gates": {
    "all_bit_identities_valid": true,
    "wrong_codebook_decode_count": 0,
    "whole_activity_scene_weighted_savings_lower_positive_all_n": true,
    "whole_activity_equal_activity_macro_savings_lower_positive_minimum_n_count": 3,
    "whole_activity_clean_loss_vs_full_manifest_maximum": 0.01,
    "report_shortest_positive_session_length": true,
    "negative_activity_results_must_be_retained": true
  },
  "claim_boundary": [
    "This is development validation on the same four activities used to design the protocol.",
    "The result validates implementation behavior but does not establish external generalization.",
    "Only known BANK codebooks use activation; OOD remains on full installation.",
    "Short-session calibration remains conservative and repeats for every cold-start segment.",
    "No new Final signal values may be accessed."
  ]
}

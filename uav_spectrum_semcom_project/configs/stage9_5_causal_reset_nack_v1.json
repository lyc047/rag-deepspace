  },
  "claim_boundary": [
    "Boot-announcement failure does not imply failure of the ordinary request-response feedback transmitter.",
    "RESET-NACK is a status hint, not an authenticated control command.",
    "Synthetic fault probabilities are stress parameters, not measured UAV failure rates.",
    "No external spectrum or aircraft-fault data are read.",
    "A positive result is software protocol evidence and does not reverse Stage-6 external Final."
  ]
}
